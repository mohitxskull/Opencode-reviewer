{
  "name": "peer",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "peer": "./src/cli/index.ts"
  },
  "scripts": {
    "lint": "biome lint src tests plugins/opencode",
    "format": "bun fmt --no-script src tests plugins/opencode",
    "format:check": "bun fmt --no-script --check src tests plugins/opencode",
    "typecheck": "bun check",
    "build": "bun build src/cli/index.ts --compile --outfile dist/peer",
    "test": "bun test"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "parse-diff": "0.14.0",
    "tree-sitter-rust": "0.24.0",
    "web-tree-sitter": "0.27.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5"
  }
}
